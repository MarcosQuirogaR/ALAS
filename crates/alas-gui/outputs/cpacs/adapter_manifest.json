{
  "manifest_version": "1",
  "source": {
    "path": "outputs\\cpacs/optimized_aircraft.cpacs.xml",
    "cpacs_version": "3.5",
    "aircraft_model_uid": "alas-aircraft-model",
    "engine_uid": "alas-engine"
  },
  "geometry": {
    "name": "ALAS Aircraft",
    "wing_count": 3,
    "fuselage_count": 3,
    "reference_area_m2": 535.0038750000001,
    "reference_chord_m": 9.778200117945687,
    "reference_span_m": 71.75,
    "moment_reference_m": [
      36.51216178154382,
      0.0,
      0.0
    ]
  },
  "adapters": [
    {
      "tool": "openvsp",
      "geometry_scope": "whole_aircraft",
      "representation": "openvsp_script",
      "derivation": "direct_from_cpacs_aircraft"
    },
    {
      "tool": "vspaero",
      "geometry_scope": "lifting_surfaces",
      "representation": "openvsp_lifting_surface_mesh",
      "derivation": "from_openvsp_geometry"
    },
    {
      "tool": "avl",
      "geometry_scope": "lifting_surfaces",
      "representation": "avl_deck",
      "derivation": "from_cpacs_lifting_surfaces"
    },
    {
      "tool": "mses",
      "geometry_scope": "root_airfoil_section",
      "representation": "mses_airfoil_dat",
      "derivation": "from_cpacs_root_airfoil"
    },
    {
      "tool": "nastran",
      "geometry_scope": "wingbox",
      "representation": "nastran_bdf",
      "derivation": "from_cpacs_wingbox_model"
    },
    {
      "tool": "flowunsteady",
      "geometry_scope": "lifting_surfaces",
      "representation": "flowunsteady_v2_request",
      "derivation": "from_cpacs_lifting_surfaces"
    }
  ]
}
