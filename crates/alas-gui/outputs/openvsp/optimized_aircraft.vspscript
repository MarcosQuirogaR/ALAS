// Keep the native CAD preview as a best-effort artifact.  The
// model/error contract below remains authoritative for runtime
// acceptance, so a graphics-context limitation cannot turn a valid
// VSP3 export into a false solver failure.
FitAllViews();
SetViewAxis( false );
SetShowBorders( false );
    WriteVSPFile("optimized_aircraft.vsp3", SET_ALL);
    string alas_vspaero_geometry_analysis = "VSPAEROComputeGeometry";
    SetAnalysisInputDefaults( alas_vspaero_geometry_analysis );
    SetIntAnalysisInput( alas_vspaero_geometry_analysis, "GeomSet", { SET_NONE }, 0 );
    SetIntAnalysisInput( alas_vspaero_geometry_analysis, "ThinGeomSet", { 3 }, 0 );
    string alas_vspaero_geometry_result = ExecAnalysis( alas_vspaero_geometry_analysis );
    if ( alas_vspaero_geometry_result.length() > 0 )
    {
        Print( string( "ALAS_VSPAERO_GEOMETRY_COMPLETE\n" ) );
    }
    int alas_model_error_count = GetNumTotalErrors();
    while ( GetNumTotalErrors() > 0 )
    {
        ErrorObj err = PopLastError();
        Print( err.GetErrorString() );
    }
    if ( alas_model_error_count == 0 )
    {
             // The thin-surface mesh above is exactly what the native
    // VSPAERO solver reads and is never modified for display
    // purposes. This second, independent export adds the fuselage
    // and landing-gear bodies as thick VSPAERO panels so the
    // report/GUI CAD preview can show the whole outer mold line.
    // A failure here is cosmetic and must not affect the solver
    // export accepted above.
        WriteVSPFile("optimized_aircraft.cad_preview.vsp3", SET_ALL);
        string alas_cad_preview_geometry_analysis = "VSPAEROComputeGeometry";
        SetAnalysisInputDefaults( alas_cad_preview_geometry_analysis );
        SetIntAnalysisInput( alas_cad_preview_geometry_analysis, "GeomSet", { 4 }, 0 );
        SetIntAnalysisInput( alas_cad_preview_geometry_analysis, "ThinGeomSet", { 3 }, 0 );
        string alas_cad_preview_geometry_result = ExecAnalysis( alas_cad_preview_geometry_analysis );
        if ( alas_cad_preview_geometry_result.length() > 0 )
        {
            Print( string( "ALAS_OPENVSP_CAD_PREVIEW_GEOMETRY_COMPLETE\n" ) );
        }
        while ( GetNumTotalErrors() > 0 )
        {
            ErrorObj preview_geometry_error = PopLastError();
            Print( string( "ALAS_OPENVSP_CAD_PREVIEW_WARNING: " ) + preview_geometry_error.GetErrorString() );
        }
        // ScreenGrab requires OpenVSP's GUI build and an available
        // graphics context. Keep that optional artifact separate
        // from model validity so headless export stays truthful.
        if ( IsGUIBuild() )
        {
                 ScreenGrab("optimized_aircraft.preview.png", 1600, 900, true, true);
                 while ( GetNumTotalErrors() > 0 )
        {
            ErrorObj preview_error = PopLastError();
            Print( string( "ALAS_OPENVSP_PREVIEW_WARNING: " ) + preview_error.GetErrorString() );
        }
        }
        else
        {
            Print( string( "ALAS_OPENVSP_PREVIEW_UNAVAILABLE: runtime has no graphics-capable GUI build\n" ) );
        }
        Print( string( "ALAS_OPENVSP_EXPORT_COMPLETE\n" ) );
        return 0;
    }
    return 1;
}
