          "min_bytes": 37000000,
          "format": "zip",
          "directory": "Gmsh-4.15.2",
          "strip_single_root": true,
          "executable": "gmsh.exe",
          "health": { "args": ["-version"], "expect_stdout_contains": "4.15.2", "timeout_seconds": 120 }
        },
        "linux-x86_64": {
          "version": "4.15.2",
          "url": "https://gmsh.info/bin/Linux/gmsh-4.15.2-Linux64.tgz",
          "sha256": "6c62116e072db29fd1f701fdb9d3d34b46ed5373545063e177b965a008274745",
