{
  "schema": 1,
  "tools": [
    {
      "id": "openvsp",
      "name": "OpenVSP / VSPAERO",
      "licence": "NASA Open Source Agreement 1.3 (as supplied by the selected release)",
      "publisher_url": "https://openvsp.org/download.php",
      "kind": "automatic",
      "summary": "Headless geometry runner (vspscript) and the VSPAERO solver.",
      "artifacts": {
        "windows-x86_64": {
          "version": "3.51.2",
          "url": "https://openvsp.org/zips/old/windows/OpenVSP-3.51.2-win64-Python3.13.zip",
          "sha256": "4d08134f5a7ff5b244fe47f557ad5b40787df631234017ea5b0b831117954252",
          "min_bytes": 1000000,
          "format": "zip",
          "directory": "OpenVSP-3.51.2-win64",
          "strip_single_root": true,
          "executable": "vspscript.exe",
          "health": {
            "args": ["-script", "{dir}/health.vspscript"],
            "case_files": {
              "health.vspscript": "void main()\n{\n    string s = \"alas-health-ok\";\n    Print(s);\n}\n"
            },
            "expect_stdout_contains": "alas-health-ok",
            "timeout_seconds": 60
          }
        }
      }
    },
    {
      "id": "gmsh",
      "name": "Gmsh",
      "licence": "GPL-2.0-or-later with linking exception",
      "publisher_url": "https://gmsh.info/",
      "kind": "automatic",
      "summary": "Mesher for CFD cases (official 4.15.2 binaries from gmsh.info).",
      "registers": "gmsh_executable",
      "artifacts": {
        "windows-x86_64": {
