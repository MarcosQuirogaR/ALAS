    {
      "id": "openfoam",
      "name": "OpenFOAM",
      "licence": "GPL-3.0 (OpenCFD release terms apply)",
      "publisher_url": "https://www.openfoam.com/download/",
      "kind": "guided",
      "summary": "System installation that needs administrator rights, so ALAS shows the steps instead of running them.",
      "guided_steps": [
        "Windows: install the OpenCFD OpenFOAM distribution from the publisher page (its own installer asks for administrator rights).",
        "Linux: install the openfoam package from the OpenCFD apt or rpm repository with your package manager.",
        "Then set the OpenFOAM location on the External Tools page."
      ]
    },
    {
      "id": "nastran95",
      "name": "NASTRAN-95",
      "licence": "NASA Open Source Agreement 1.3",
      "publisher_url": "https://github.com/Foadsf/NASTRAN-95",
      "kind": "build_from_source",
      "summary": "Source-only upstream: ALAS downloads the pinned NASA source, applies its reviewed local patch and compiles it on this computer. No binary is downloaded or redistributed.",
      "artifacts": {
        "windows-x86_64": {
          "version": "060ed900",
          "url": "https://codeload.github.com/Foadsf/NASTRAN-95/tar.gz/060ed900db822745353fcce96bddc1565027e7db",
          "sha256": "a2519ad6ab817d082fcf169362411e32e55c1f8dc5284d47b8a92668c0a9b977",
          "size_bytes": 89367721,
          "min_bytes": 80000000,
          "format": "tar.gz",
          "directory": "NASTRAN-95",
          "strip_single_root": true,
          "executable": "build/bin/nastran.exe"
        },
        "linux-x86_64": {
          "version": "060ed900",
          "url": "https://codeload.github.com/Foadsf/NASTRAN-95/tar.gz/060ed900db822745353fcce96bddc1565027e7db",
          "sha256": "a2519ad6ab817d082fcf169362411e32e55c1f8dc5284d47b8a92668c0a9b977",
          "size_bytes": 89367721,
          "min_bytes": 80000000,
          "format": "tar.gz",
          "directory": "NASTRAN-95",
          "strip_single_root": true,
          "executable": "build/bin/nastran"
        }
      },
      "build": {
        "patch": "nastran95-alas-local",
        "disk_bytes": 600000000,
        "toolchain": {
          "windows-x86_64": [
            {
              "version": "winlibs-gcc-16.2.0",
              "licence": "GCC and MinGW-w64 runtime: GPL-3.0-or-later with the GCC Runtime Library Exception; binutils GPL-3.0-or-later; CMake BSD-3-Clause; Ninja Apache-2.0 (as packaged by the winlibs project)",
              "url": "https://github.com/brechtsanders/winlibs_mingw/releases/download/16.2.0posix-23.1.3-14.0.0-ucrt-r3/winlibs-x86_64-posix-seh-gcc-16.2.0-mingw-w64ucrt-14.0.0-r3.zip",
              "sha256": "3c69305081e4a647144339a936244fcf7d3d9e558319e1ad7be2cd2886d4b6a1",
              "size_bytes": 276414382,
              "min_bytes": 250000000,
              "extracted_bytes": 1000000000,
              "format": "zip",
              "directory": "winlibs-gcc-16.2.0",
              "strip_single_root": true,
              "executable": "bin/gfortran.exe"
            }
          ]
        },
        "path_dirs": { "windows-x86_64": ["bin"] },
        "required_commands": { "linux-x86_64": ["gfortran", "cmake", "ninja"] },
        "missing_commands_hint": {
          "linux-x86_64": "Install the build tools first: sudo apt-get install gfortran cmake ninja-build"
        },
        "steps": {
          "windows-x86_64": [
            {
              "program": "cmake",
              "args": ["-S", "{src}", "-B", "{src}/build", "-G", "Ninja", "-DCMAKE_Fortran_COMPILER=gfortran", "-DNASTRAN95_OPEN_CORE_WORDS=64000000", "-DCMAKE_EXE_LINKER_FLAGS=-static"],
              "timeout_seconds": 600
            },
            {
              "program": "cmake",
              "args": ["--build", "{src}/build", "--target", "nastran", "-j", "{jobs}"],
              "timeout_seconds": 3600
            }
          ],
          "linux-x86_64": [
            {
              "program": "cmake",
              "args": ["-S", "{src}", "-B", "{src}/build", "-G", "Ninja", "-DCMAKE_Fortran_COMPILER=gfortran", "-DNASTRAN95_OPEN_CORE_WORDS=64000000", "-DCMAKE_EXE_LINKER_FLAGS=-static-libgfortran -static-libgcc"],
              "timeout_seconds": 600
            },
            {
              "program": "cmake",
              "args": ["--build", "{src}/build", "--target", "nastran", "-j", "{jobs}"],
              "timeout_seconds": 3600
            }
          ]
        },
        "keep": ["build/bin/nastran", "build/bin/nastran.exe", "build/bin/nastran95-open-core.txt", "rf"],
        "check": "nastran95-closed-form"
      }
    },
    {
      "id": "mses",
      "name": "MSES (mset, mses, mplot)",
      "licence": "Proprietary, per-seat licence from MIT",
      "publisher_url": "https://tlo.mit.edu/industry-entrepreneurs/available-technologies/mses-software-high-lift-multielement-airfoil",
      "kind": "guided",
      "summary": "Licence-gated: MIT supplies it on request.",
