      "guided_steps": [
        "Obtain a licence and installer from Hexagon (a Student Edition also exists).",
        "ALAS finds a default MSC installation automatically; otherwise set the executable on the External Tools page."
      ]
    },
    {
      "id": "flowunsteady",
      "name": "FLOWUnsteady / Julia adapter",
      "licence": "User-supplied; follows the selected release",
      "publisher_url": "https://github.com/byuflowlab/FLOWUnsteady",
      "kind": "guided",
      "summary": "A Julia environment whose dependency closure the user chooses.",
      "guided_steps": [
        "Install Julia and FLOWUnsteady following the project instructions.",
        "Set the adapter launcher on the External Tools page."
      ]
    }
  ]
}
