          "min_bytes": 36000000,
          "format": "tar.gz",
          "directory": "Gmsh-4.15.2",
          "strip_single_root": true,
          "executable": "bin/gmsh",
          "health": { "args": ["-version"], "expect_stdout_contains": "4.15.2", "timeout_seconds": 120 }
        }
      }
    },
    {
