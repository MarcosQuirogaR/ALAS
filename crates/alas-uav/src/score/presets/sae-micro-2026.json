{
  "id": "sae-micro-2026",
  "version": 1,
  "family": "sae_aero_design",
  "name": "SAE Aero Design 2026, Micro class (liquid payload)",
  "status": "official",
  "citation": "SAE Aero Design 2026 Rules 2026.0 (2025-09-05), s9 Micro class (requirements printed p.40-41, take-off s9.5 p.41, scoring s9.6 p.42); local copy refs/competitions/SAE2026_AeroDesign_rules.pdf; the empty-weight term is (W_empty - 1)^4 + 8.9 on the rendered page (competitions.md printed it as /4, which is wrong)",
  "gates": [
    {
      "id": "cells",
      "description": "At most 4 cells",
      "margin_expr": "(4 - cell_count) / 4",
      "hard": true,
      "citation": "SAE Aero Design 2026 Rules 2026.0 (2025-09-05) Micro battery, printed p.40"
    },
    {
      "id": "container",
      "description": "Payload container >= 67 fl oz",
      "margin_expr": "(container_volume - 67 floz) / (67 floz)",
      "hard": true,
      "citation": "SAE Aero Design 2026 Rules 2026.0 (2025-09-05) Micro payload container, printed p.40"
    },
    {
      "id": "takeoff",
      "description": "Take-off within 100 ft (else attempt disqualified)",
      "margin_expr": "(100 ft - takeoff_distance) / (100 ft)",
      "hard": true,
      "citation": "SAE Aero Design 2026 Rules 2026.0 (2025-09-05) Micro take-off, printed p.41"
    },
    {
      "id": "limiter",
      "description": "Battery power at or below the 450 W limiter (the limiter clips a higher demand; margin shows where it binds)",
      "margin_expr": "(450 W - peak_power) / (450 W)",
      "hard": false,
      "citation": "SAE Aero Design 2026 Rules 2026.0 (2025-09-05) Micro power limiter, printed p.40"
    }
  ],
  "parameters": [],
  "segments": [
    {
      "name": "takeoff",
      "kind": {
        "kind": "takeoff",
        "runway_m": 30.0,
        "surface": "hard"
      }
    },
    {
      "name": "climb",
      "kind": {
        "kind": "climb",
        "end": {
          "until": "altitude",
          "meters": 30.0
        }
      }
    },
    {
      "name": "circuit",
      "kind": {
        "kind": "laps",
        "lap_length_m": 400.0,
        "turn_gate": true,
        "count": 3
      }
    },
    {
      "name": "landing",
      "kind": {
        "kind": "landing",
        "zone_m": null
      }
    }
  ],
  "score": {
    "terms": [
      {
        "name": "b_takeoff",
        "expr": "step(takeoff_distance, 10 ft, 20, 25 ft, 15, 50 ft, 9, 100 ft, 0, 0)",
        "additive_bonus": false
      },
      {
        "name": "w_payload",
        "expr": "payload_mass / (1 lb)",
        "additive_bonus": false
      },
      {
        "name": "m_empty",
        "expr": "11 / ((empty_mass / (1 lb) - 1)^4 + 8.9)",
        "additive_bonus": false
      },
      {
        "name": "z",
        "expr": "b_takeoff - (span / (1 ft))^1.5",
        "additive_bonus": false
      },
      {
        "name": "fs",
        "expr": "3 * w_payload * m_empty + z",
        "additive_bonus": false
      }
    ],
    "round_expr": "if(takeoff_distance <= 100 ft, fs, 0)",
    "aggregation": {
      "kind": "sum_best_k",
      "k": 3
    },
    "reference_field": []
  },
  "variants": []
}
