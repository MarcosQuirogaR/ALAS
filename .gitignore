/target/
/target-terra/
/tmp/
/.landmark-backups/
/exports/
/.alas-onboarding-seen

# Local editor, assistant and scratch state. Never part of the project; listed
# so that a working copy cannot accidentally publish it.
/.agent/
/.codex/
/.codex-metadata.json
/.claude/
/CONTEXT.md
/MISSING-THINGS.md
**/*.rs.bk
*.pdb

# Run outputs and scratch analysis directories produced by the application.
/out/
/runs/
/outputs/
/crates/*/outputs/
/dist/
/exported_figures/
/reference_figures/
/visual_check/
/visual_check2/

# Local Airfoil CFD study/environment preferences (machine-specific paths).
/airfoil-cfd-environment.json
/airfoil-cfd-study.json
/airfoil-cfd-sweep.json

# Downloaded-on-demand assets: navigation data (GPL-3.0) and the Blue Marble
# texture are fetched at runtime, never redistributed from this tree.
/assets/navdata/
/assets/textures/*
!/assets/textures/
!/assets/textures/earth_blue_marble.png
!/assets/textures/natural_earth_110m_land.geojson
!/assets/textures/README.md

# Session hand-off notes, kept local: working scratch, not project record.
/NOTE.md

# External tools are acquired by the user, never redistributed by this
# repository. MSES is proprietary (MIT Technology Licensing Office) and OpenVSP
# is only redistributable from a specifically reviewed release, so neither may
# be committed here. See THIRD-PARTY-NOTICES.md for the terms of each tool and
# docs/downloads.md for how the application acquires them.
#
# AVL is the exception and stays tracked: GPL-2.0 permits redistribution, and
# the binary, its corresponding source archive and the licence text are all
# present, which is what `bundle_avl` in xtask/src/dist.rs packages.
/external tools/*
!/external tools/AVL-GPL-2.0.txt
!/external tools/avl352.exe
!/external tools/avl3.52.tgz
!/external tools/cpacs_schema.xsd
!/external tools/alas_uav_cpacs35.xsd

# Runtime user configuration written by the application at run time.
/alas-config.json

# A global or editor ignore rule for build/ directories would otherwise hide
# this module, which is ordinary Rust source rather than a build output.
!crates/alas-pipeline/src/cabin_scene/build/
